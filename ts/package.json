{
  "name": "hron-ts",
  "version": "2.1.0",
  "description": "Human-readable cron \u2014 native TypeScript implementation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "typecheck:dist": "tsc -p test/types",
    "lint": "biome check src/ test/",
    "lint:fix": "biome check --write src/ test/"
  },
  "dependencies": {
    "temporal-polyfill": "^1.0.5"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/simpllyf/hron",
    "directory": "ts"
  },
  "homepage": "https://github.com/simpllyf/hron",
  "bugs": {
    "url": "https://github.com/simpllyf/hron/discussions"
  },
  "keywords": [
    "cron",
    "schedule",
    "human-readable",
    "hron",
    "temporal"
  ]
}
